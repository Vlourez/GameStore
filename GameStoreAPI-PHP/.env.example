# Banco de dados (MySQL / XAMPP / phpMyAdmin)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gamestore_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# JWT
# Gere um valor novo:  php -r "echo bin2hex(random_bytes(32));"   (mínimo 32 caracteres)
JWT_SECRET=troque-esta-chave-por-uma-bem-longa-e-aleatoria-em-producao
JWT_ISSUER=GameStoreAPI
JWT_AUDIENCE=GameStoreAPI.Clients

# Ambiente
APP_ENV=local
APP_DEBUG=true

# CORS: * (qualquer origem), ou lista separada por vírgula. Ex.: http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGIN=*
